{
  "name": "maz-suplementos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "format": "prettier --write . --ignore-path .gitignore --ignore-unknown",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-unknown",
    "dev": "concurrently -k -n API,WEB -c cyan,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm start -w backend",
    "test": "npm test -w backend",
    "test:e2e": "playwright test",
    "db:check": "npm run db:check -w backend",
    "db:init": "npm run db:init -w backend",
    "seed:admin": "npm run seed:admin -w backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0"
  }
}
