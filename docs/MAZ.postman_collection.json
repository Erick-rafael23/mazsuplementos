{
  "info": {
    "name": "MAZ Suplementos · API REST",
    "description": "Usa cuentas de prueba. Inicia sesión con el rol adecuado antes de usar cada carpeta. DELETE elimina registros. No exportes variables con secretos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000/api"
    },
    {
      "key": "correo",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "usuarioId",
      "value": "0"
    },
    {
      "key": "productoId",
      "value": "0"
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Estado del servidor",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Iniciar sesión (completa correo y password locales)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) { pm.collectionVariables.set(\"token\", pm.response.json().data.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Mi sesión",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Usuarios · administrador (auditor solo GET)",
      "item": [
        {
          "name": "Consultar usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/usuarios"
          }
        },
        {
          "name": "Crear usuario de prueba",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Capturista de prueba\",\n  \"correo\": \"capturista-prueba@example.com\",\n  \"password\": \"ClaveDePrueba2026!\",\n  \"rol\": \"capturista\",\n  \"activo\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/usuarios"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) { pm.collectionVariables.set(\"usuarioId\", pm.response.json().data.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar usuario creado",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/usuarios/{{usuarioId}}"
          }
        },
        {
          "name": "Actualizar usuario creado",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Capturista actualizado\",\n  \"correo\": \"capturista-prueba@example.com\",\n  \"rol\": \"capturista\",\n  \"activo\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/usuarios/{{usuarioId}}"
          }
        },
        {
          "name": "Eliminar usuario de prueba",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/usuarios/{{usuarioId}}"
          }
        }
      ]
    },
    {
      "name": "Productos · capturista (otros roles solo GET)",
      "item": [
        {
          "name": "Consultar catálogo",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/productos"
          }
        },
        {
          "name": "Crear suplemento de prueba",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Creatina de prueba\",\n  \"descripcion\": \"300 g\",\n  \"tipo\": \"producto\",\n  \"precio\": 449,\n  \"activo\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/productos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) { pm.collectionVariables.set(\"productoId\", pm.response.json().data.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar suplemento creado",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/productos/{{productoId}}"
          }
        },
        {
          "name": "Actualizar suplemento creado",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Creatina de prueba\",\n  \"descripcion\": \"300 g\",\n  \"tipo\": \"producto\",\n  \"precio\": 429,\n  \"activo\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/productos/{{productoId}}"
          }
        },
        {
          "name": "Eliminar suplemento de prueba",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/productos/{{productoId}}"
          }
        }
      ]
    },
    {
      "name": "Respaldos · solo administrador",
      "item": [
        {
          "name": "Crear respaldo local",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/backups"
          }
        },
        {
          "name": "Historial de respaldos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/backups"
          }
        }
      ]
    }
  ]
}
